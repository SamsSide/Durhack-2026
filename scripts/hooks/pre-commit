#!/usr/bin/env bash
# DurHack: no commits on main. Work on a <lane>/<topic> branch.
b="$(git branch --show-current)"
if [ "$b" = "main" ] || [ "$b" = "master" ]; then
  echo "DurHack rule: don't commit on $b. Run: git switch -c <lane>/<topic>" >&2
  exit 1
fi
# No secrets.
if git diff --cached -U0 | grep -E '^\+' | grep -qE '(sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{30,}|AIza[0-9A-Za-z_-]{35})'; then
  echo "That looks like an API key in the staged changes. Put it in .env (git-ignored)." >&2
  exit 1
fi
if git diff --cached --name-only | grep -qE '(^|/)\.env$'; then
  echo ".env must never be committed (list the names in .env.example instead)." >&2
  exit 1
fi
exit 0
