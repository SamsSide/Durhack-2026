{
  "name": "terra-nova",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "mock": "concurrently -n mock,web -c magenta,green \"npm run mock -w server\" \"npm run dev -w web\"",
    "mock:server": "npm run mock -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "demo": "bash scripts/demo.sh mock",
    "demo:live": "bash scripts/demo.sh live",
    "demo:reset": "bash scripts/demo.sh reset",
    "demo:stop": "bash scripts/demo.sh stop",
    "demo:status": "bash scripts/demo.sh status"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
