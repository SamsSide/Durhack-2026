# Copy to .env (git-ignored). Names only; get the values from the owner in person.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVEN_MODEL=eleven_multilingual_v2
ELEVEN_MAX_CHARS_PER_RUN=30000
ELEVEN_CHANT_MODEL=eleven_v3
TEAM_VOICES=
ELEVEN_MUSIC_MODEL=music_v1
ANTHEM_MAX_PER_RUN=8
BROADCAST_MAX_PER_RUN=12
LLM_MODE=mock
GEMINI_MODEL_RULER=gemini-3.5-flash-lite
GEMINI_MODEL_BIBLE=gemini-3.5-flash-lite
GEMINI_MODEL_LORE=gemini-3.5-flash
# LLM provider: gemini (default) | gemma-api | ollama | hybrid. Audio and painted flags always use Gemini.
LLM_PROVIDER=gemini
# Gemma through the Gemini API (provider gemma-api)
GEMMA_API_MODEL=gemma-4-26b-a4b-it
# Local Gemma through Ollama (providers ollama and hybrid)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b-it-qat
# In hybrid, these purposes go to Ollama, everything else to Gemini
LLM_LOCAL_PURPOSES=ruler
LLM_MAX_CALLS_PER_MIN=20
LLM_MAX_TOKENS_PER_RUN=400000
PORT=8787
TIGER_DATABASE_URL=
# Solana economy (row A27): off | mock | devnet
SOLANA_MODE=mock
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_KEYS_DIR=
SOLANA_SETTLE_MS=5000
SOLANA_MAX_TX_PER_WINDOW=4
SOLANA_FLOAT=10000
